rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if user is authenticated
    function isAuth() {
      return request.auth != null && request.auth.uid != null;
    }

    // Helper: get user role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol;
    }

    // Helper: get user's organization id
    function getUserOrg() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.organizacionId;
    }

    // Helper: check if user is superAdmin
    function isSuperAdmin() {
      return isAuth() && getUserRole() == 'superAdmin';
    }

    // Helper: check if user is orgAdmin (or superAdmin)
    function isOrgAdmin() {
      return isAuth() && (getUserRole() == 'orgAdmin' || getUserRole() == 'superAdmin');
    }

    // Helper: check if user belongs to the same organization
    function isSameOrg(orgId) {
      return isAuth() && getUserOrg() == orgId;
    }

    // Helper: check if user can manage this organization's data
    function canManageOrg(orgId) {
      return isAuth() && (isSuperAdmin() || (isSameOrg(orgId) && (getUserRole() == 'orgAdmin' || getUserRole() == 'vendedor')));
    }

    // ===== users collection =====
    match /users/{uid} {
      allow read: if isAuth() && (
        request.auth.uid == uid ||
        isSuperAdmin() ||
        getUserRole() == 'orgAdmin'
      );
      allow create: if isSuperAdmin() || getUserRole() == 'orgAdmin' || request.auth.uid == uid;
      allow update: if (isAuth() && request.auth.uid == uid && request.resource.data.rol == resource.data.rol)
                    || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ===== organizaciones collection =====
    match /organizaciones/{orgId} {
      // superAdmin can read/write all orgs; org members can read their own org
      allow read: if isSuperAdmin() || (isAuth() && getUserOrg() == orgId);
      allow create: if isSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ===== rifas collection =====
    match /rifas/{rifaId} {
      allow read: if !isAuth() || isSuperAdmin() || (isAuth() && canManageOrg(resource.data.organizacionId));
      allow create: if isOrgAdmin();
      allow update, delete: if isSuperAdmin() || (isAuth() && getUserRole() == 'orgAdmin' && isSameOrg(resource.data.organizacionId));

      // ===== rifas/{rifaId}/numeros subcollection =====
      match /numeros/{numero} {
        allow read: if !isAuth() || isSuperAdmin() || (isAuth() && canManageOrg(get(/databases/$(database)/documents/rifas/$(rifaId)).data.organizacionId));
        allow write: if !isAuth() || isSuperAdmin() || (isAuth() && getUserRole() == 'orgAdmin' && isSameOrg(get(/databases/$(database)/documents/rifas/$(rifaId)).data.organizacionId))
          && request.resource.data.keys().hasAll(['estado', 'participanteId', 'rifaId'])
          && request.resource.data.estado in ['disponible', 'reservado', 'pagado', 'ocupado'];
      }
    }

    // ===== participantes collection =====
    match /participantes/{participanteId} {
      allow read: if !isAuth() || (isAuth() && (isSuperAdmin() || getUserRole() == 'orgAdmin' || getUserRole() == 'vendedor'));
      allow create: if (!isAuth() || (isAuth() && (isSuperAdmin() || getUserRole() == 'orgAdmin' || getUserRole() == 'vendedor')))
        && request.resource.data.keys().hasAll(['nombre', 'whatsapp', 'numeros', 'rifaId'])
        && request.resource.data.numeros.size() > 0
        && request.resource.data.numeros.size() <= 100
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.whatsapp is string
        && request.resource.data.whatsapp.matches('^[0-9+]{7,15}$');
      allow update, delete: if isOrgAdmin();
    }

    // ===== config collection =====
    match /config/{configId} {
      allow read: if isAuth();
      // Only superAdmin can write to config
      allow write: if isSuperAdmin();
    }

    // ===== appConfig document =====
    match /appConfig/{docId} {
      allow read: if isAuth();
      allow write: if isSuperAdmin();
    }

    // Default: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
